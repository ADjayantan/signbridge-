# Copy to .env.local only if it does not already exist; never overwrite a real key.
# npm run rooms loads .env.local. npm start reads the hosting environment.
# Vite also reads .env.local. Private keys stay server-side and must not be committed.
# On Render, set private values in the service's Environment page.

# Local room server: Vite's default room proxy expects port 3001.
# Render supplies PORT itself; leave its provided value unchanged there.
PORT=3001

# Additional room HTTP/WebSocket frontend origins (comma-separated).
# Same-host origins and localhost development origins are already allowed.
# ROOM_ALLOWED_ORIGINS=https://signbridge.vercel.app

# Optional for relayed video: use a free Metered Open Relay account.
# Domain: your-app.metered.live (bare your-app is also accepted).
# Use the credential-scoped API key: TURN Server > Credentials > Get credential > Show API Key.
# The account Developers > Secret key and signaling/SDK keys are not used by this endpoint.
# Existing credentials are fetched; this app does not create/rotate expiring credentials.
METERED_DOMAIN=
METERED_TURN_API_KEY=

# Public frontend URL setting for a separately hosted room server.
# Leave unset for same-origin hosting. Changing it requires a frontend rebuild.
# This URL is public; NEVER prefix a Gemini/Metered secret with VITE_.
# VITE_ROOM_SERVER_URL=https://your-room-service.onrender.com

# Optional AI help / AI practice tools; human conversations do not need this key.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional text model override.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional model for experimental sign-video interpretation in the existing tools.
# Defaults to gemini-3.5-flash (GEMINI_MODEL overrides this unless GEMINI_SIGN_MODEL is set).
# GEMINI_SIGN_MODEL=gemini-3.5-flash

# Optional Gemini thinking level: minimal, low, medium or high.
# GEMINI_THINKING_LEVEL=minimal

# Optional additional Gemini handler restriction; not authentication.
# Standalone POST /api/chat also requires active room-member credentials.
# ALLOWED_ORIGINS=https://your-room-service.onrender.com
