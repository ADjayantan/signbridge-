# Copy to .env.local for `npm run dev`; on Vercel, add these under Project → Settings → Environment Variables.
# Never commit your real key. .env.local is git-ignored.

# Required: a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: the model to use (default: gemini-3.5-flash-lite, the fastest; try gemini-3.8-flash for harder questions)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: thinking level for Gemini 3 models: minimal, low, medium or high (default: the model's own default)
# GEMINI_THINKING_LEVEL=minimal

# Optional: only these sites may call /api/chat (comma-separated), e.g. your Vercel URL
# ALLOWED_ORIGINS=https://signbridge.vercel.app
